{
  "compilerOptions": {
    "target": "ES2019",
    "module": "esnext",
    "ignoreDeprecations": "6.0",
    "jsx": "react",
    "jsxFactory": "h",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "composite": true,
    "declarationMap": true,
    "baseUrl": "./",
    "rootDir": "./",
    "outDir": ".tmp/ts",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "static-build/*": ["./src/static-build/*"],
      "client/*": ["./src/client/*"],
      "shared/*": ["./src/shared/*"],
      "features/*": ["./src/features/*"],
      "worker-shared/*": ["./src/worker-shared/*"]
    }
  }
}
