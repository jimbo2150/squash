{
  "private": true,
  "name": "squash",
  "version": "2.0.0",
  "license": "apache-2.0",
  "scripts": {
    "build": "npm run generate:codec-versions && rollup -c && node lib/move-output.js",
    "generate:codec-versions": "node codecs/generate-version-metadata.mjs",
    "debug": "node --inspect-brk node_modules/.bin/rollup -c",
    "dev": "DEV_PORT=\"${DEV_PORT:=5000}\" run-p watch serve",
    "watch": "npm run generate:codec-versions && rollup -cw",
    "serve": "serve --listen=$DEV_PORT --config ../../../serve.json .tmp/build/static",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@surma/rollup-plugin-off-main-thread": "^2.2.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@web/rollup-plugin-import-meta-assets": "^3.0.0",
    "comlink": "^4.4.2",
    "cssnano": "^9.6.0",
    "dedent": "^1.7.2",
    "del": "^9.0.1",
    "file-drop-element": "^1.0.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "idb-keyval": "^6.3.0",
    "image-size": "^2.0.4",
    "linkstate": "^2.0.1",
    "lint-staged": "^17.6.0",
    "lodash.camelcase": "^4.3.0",
    "mime-types": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "pointer-tracker": "^2.5.3",
    "postcss": "^8.5.29",
    "postcss-modules": "^9.0.1",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "postcss-url": "^10.1.4",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.5",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "wasm-feature-detect": "^1.9.0"
  },
  "overrides": {
    "compression": "1.8.2"
  },
  "lint-staged": {
    "*.{js,css,json,md,ts,tsx}": "prettier --write",
    "*.{c,h,cpp,hpp}": "clang-format -i",
    "*.rs": "rustfmt"
  }
}
